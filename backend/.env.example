# ──────────────────────────────────────────────────────────────
# BharatX Group — Backend Environment Variables (Render)
# ──────────────────────────────────────────────────────────────

PORT=5000

# MongoDB connection string (Atlas recommended)
MONGO_URI=mongodb+srv://BharatXGroup:Bharatxgroup123@bharatxgroup.oddzwdq.mongodb.net/bharatx?retryWrites=true&w=majority&appName=BharatXGroup

# Secret used to sign JWT tokens (admin auth).
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed origins for CORS (Vercel domain)
# Example: https://bharatx-group.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Max contact submissions per IP per 15 minutes.
RATE_LIMIT_MAX=6

# Admin credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (optional — Nodemailer SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
